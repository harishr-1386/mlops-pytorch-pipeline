# =============================================================================
# Serving image -- inference only, no training libraries
# Runs FastAPI via uvicorn on port 8080 as a non-root user.
# =============================================================================
FROM python:3.11-slim AS serve

WORKDIR /app

# Inference dependencies only (no tensorboard, no torchvision training extras)
COPY requirements/serve.txt ./requirements/serve.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements/serve.txt \
    && rm -rf /root/.cache/pip

# Application code
COPY src/ ./src/
COPY configs/ ./configs/

# Non-root user
RUN useradd --create-home --uid 1001 appuser
USER appuser

ENV PYTHONUNBUFFERED=1

EXPOSE 8080

# Health check: poll /health every 30s, 3 retries, 10s start period
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" || exit 1

# Checkpoint volume mount expected at /app/checkpoints (read-only in K8s)
ENTRYPOINT ["python", "-m", "uvicorn", "src.serve:app", "--host", "0.0.0.0", "--port", "8080"]
